PORT=8080

# GitHub personal access token with repo scope (used to fetch commit diffs
# and post review comments back to GitHub)
GITHUB_TOKEN=

# Secret configured on the GitHub webhook, used to verify incoming payloads
GITHUB_WEBHOOK_SECRET=

# OpenAI API key used to run the AI code review
OPENAI_API_KEY=
# Optional: override the default model (gpt-4o-mini)
OPENAI_MODEL=
